      "html": "<button class=\"ds-search\">Search</button>",
      "css": ".ds-search{font-family:\"DM Sans\",system-ui,sans-serif;font-size:14px;line-height:1.5;font-variant-numeric:tabular-nums;height:44px;padding:0 16px;border:0;border-radius:0 7px 7px 0;background:var(--text,#292b28);color:var(--surface,#fff);cursor:pointer;transition:opacity .15s}.ds-search:hover{opacity:.8}.ds-search:focus-visible{outline:2px solid var(--focus,#9d4224);outline-offset:4px;}.ds-search:disabled{opacity:.6;cursor:wait}"
    },
    {
      "name": "Text action",
      "kind": "button",
      "refersTo": "button-text",
      "description": "Accent action for retry or clearing recent places.",
      "html": "<button class=\"ds-text\">Clear recent</button>",
      "css": ".ds-text{font-family:\"DM Sans\",system-ui,sans-serif;font-size:14px;line-height:1.5;font-variant-numeric:tabular-nums;min-height:40px;padding:8px 4px;border:0;background:transparent;color:var(--accent,#b34d2b);font-weight:500;cursor:pointer}.ds-text:hover{text-decoration:underline;text-underline-offset:4px}.ds-text:focus-visible{outline:2px solid var(--focus,#9d4224);outline-offset:4px;}"
    },
    {
