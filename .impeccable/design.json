      "html": "<button class=\"ds-icon\" aria-label=\"Change theme\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z\"/></svg></button>",
      "css": ".ds-icon{width:44px;height:44px;border:0;border-radius:8px;display:inline-grid;place-items:center;background:transparent;color:var(--text,#292b28);cursor:pointer}.ds-icon svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.65;stroke-linecap:round;stroke-linejoin:round}.ds-icon:hover{background:var(--raised,#f1f0ec)}.ds-icon:focus-visible{outline:2px solid var(--focus,#9d4224);outline-offset:4px;}"
    },
